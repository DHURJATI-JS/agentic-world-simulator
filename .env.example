# Copy to ".env" (same folder as docker-compose.yml / run.py). Docker Compose and run.py both read it.
# AI hierarchy: OpenAI Gemma -> Local Gemma -> Anthropic -> unavailable

# Tier 1 - OpenAI Gemma: copy base_url / api_key / model from the "Local AI gateway" window.
# Several comma-separated URLs are allowed; the first that answers is used.
OPENAI_GEMMA_URL=http://192.168.0.101:8000/v1
OPENAI_GEMMA_API_KEY=
OPENAI_GEMMA_MODEL=gemma

# Tier 2 - Local Gemma on this PC (Ollama container). Bigger/newer option: gemma4:e4b
LOCAL_GEMMA_MODEL=gemma3:4b
EMBEDDING_MODEL=embeddinggemma

# Tier 3 - Anthropic (Claude). Leave empty to skip this tier.
ANTHROPIC_API_KEY=

# Session signing secret (any long random string)
APP_SECRET_KEY=
